# Example env file — copy to .env and edit values for your environment
NODE_ENV=development
PORT=3000
DB_TYPE=JSON
DATA_DIR=./data

# If using MongoDB set DB_TYPE=MONGO and provide your URI
MONGO_URI=mongodb://localhost:27017/colman_db
MONGO_INITDB_DATABASE=colman_db
MONGO_INITDB_ROOT_USERNAME=admin
MONGO_INITDB_ROOT_PASSWORD=changeme

JWT_SECRET=replace_this_with_a_strong_secret
NODE_ENV=development
PORT=3000
DATA_STORE=JSON
MONGO_URI=mongodb://localhost:27017/colman_db
MONGO_INITDB_ROOT_USERNAME=admin
MONGO_INITDB_ROOT_PASSWORD=passw0rd
MONGO_INITDB_DATABASE=colman_db
