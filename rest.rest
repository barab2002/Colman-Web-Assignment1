@baseUrl = http://localhost:3000
@token = 

### Login (get JWT)
POST {{baseUrl}}/api/auth/login
Content-Type: application/json

{
  "username": "admin",
  "password": "password"
}

### Health - Mongo
GET {{baseUrl}}/api/health/mongo

### Create Post
POST {{baseUrl}}/api/post
Content-Type: application/json
Authorization: Bearer {{token}}

{
  "senderId": "user1",
  "title": "Test post",
  "content": "This is a test post"
}

### List Posts
GET {{baseUrl}}/api/post
Authorization: Bearer {{token}}

### Get Post by ID
GET {{baseUrl}}/api/post/{{postId}}
Authorization: Bearer {{token}}

### Update Post
PUT {{baseUrl}}/api/post/{{postId}}
Content-Type: application/json
Authorization: Bearer {{token}}

{
  "title": "Updated title",
  "content": "Updated content"
}

### Create Comment
POST {{baseUrl}}/api/comment
Content-Type: application/json
Authorization: Bearer {{token}}

{
  "postId": "{{postId}}",
  "senderId": "user2",
  "content": "Nice post!"
}

### Get Comment by ID
GET {{baseUrl}}/api/comment/{{commentId}}
Authorization: Bearer {{token}}

### Update Comment
PUT {{baseUrl}}/api/comment/{{commentId}}
Content-Type: application/json
Authorization: Bearer {{token}}

{
  "content": "Edited comment"
}

### Delete Comment
DELETE {{baseUrl}}/api/comment/{{commentId}}
Authorization: Bearer {{token}}

### Get Comments For Post
GET {{baseUrl}}/api/post/{{postId}}/comments
Authorization: Bearer {{token}}
