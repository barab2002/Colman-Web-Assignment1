{
  "name": "colman-web-assignment1",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "ts-node-dev --respawn --transpile-only src/server.ts",
    "mongo:up": "docker compose up -d mongo",
    "mongo:down": "docker compose down",
    "dev:with-mongo": "npm run mongo:up && npm run dev",
    "dev:ensure-mongo": "node ./scripts/ensure-mongo.js && npm run dev",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js"
  },
  "dependencies": {
    "dotenv": "^16.0.0",
    "express": "^4.18.2",
    "mongodb": "^5.9.0",
    "mongoose": "^7.4.0",
    "swagger-ui-express": "^4.6.3"
  },
  "devDependencies": {
    "@types/express": "^4.17.17",
    "@types/node": "^20.5.1",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.1.6"
  }
}
