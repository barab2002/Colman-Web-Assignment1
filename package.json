{
  "name": "colman-web-assignment1",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "ts-node-dev --respawn --transpile-only src/server.ts",
    "mongo:up": "docker compose up -d mongo",
    "mongo:down": "docker compose down",
    "dev:with-mongo": "npm run mongo:up && npm run dev",
    "dev:ensure-mongo": "node ./scripts/ensure-mongo.js && npm run dev",
    "smoke": "npx newman run postman/Colman-Web-Assignment1.postman_collection.json -e postman/Colman-Web-Assignment1.postman_environment.json --color on --delay-request 2000",
    "test": "jest",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js"
  },
  "dependencies": {
    "dotenv": "^16.0.0",
    "express": "^4.18.2",
    "mongodb": "^5.9.0",
    "mongoose": "^7.4.0",
    "jsonwebtoken": "^9.0.0",
    "bcryptjs": "^2.4.3",
    "swagger-ui-express": "^4.6.3"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.2",
    "@types/express": "^4.17.17",
    "@types/jest": "^29.5.12",
    "@types/node": "^20.5.1",
    "jest": "^29.7.0",
    "jest-html-reporters": "^3.1.0",
    "ts-jest": "^29.1.1",
    "ts-node-dev": "^2.0.0",
    "@types/jsonwebtoken": "^9.0.2",
    "typescript": "^5.1.6"
  }
}
